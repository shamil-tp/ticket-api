{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ticket-api",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://shamiltp.me"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shamiltp-tickets",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}